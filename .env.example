# Variables de entorno del Orchestrator.
# Valores de EJEMPLO: copiar a .env y ajustarlos al despliegue real.
# Las URLs son placeholders: deben apuntar a los servicios del despliegue (por ejemplo http://validator:8000).

# URLs base de los servicios coordinados (obligatorias).
VALIDATOR_URL=http://validator.example
EXTRACTOR_URL=http://extractor.example
PERSISTENCE_URL=http://persistence.example

# Tiempo máximo de espera de httpx por fase de cada llamada a un servicio, en segundos (> 0).
HTTP_TIMEOUT_SECONDS=10

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Puerto en el que escucha el Orchestrator.
PORT=8000
